# Dockerfile para CLI interactivo de SQUIT
# Basado en Python 3.12 slim para optimizar tamaño
FROM python:3.12-slim-bookworm AS base

# Variables de entorno para optimización de Python
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    TERM=xterm-256color

# ============================================================================
# Stage 1: Builder - Instalar dependencias
# ============================================================================
FROM base AS builder

# Instalar dependencias del sistema necesarias para compilación
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Crear entorno virtual
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copiar requirements e instalar dependencias Python
COPY requirements.txt .

# Instalar dependencias con retry y mejor logging
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt --timeout=300 --retries=3

# ============================================================================
# Stage 2: Runtime - Imagen final optimizada
# ============================================================================
FROM base AS runtime

# Instalar solo las dependencias de runtime necesarias
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copiar entorno virtual del builder
COPY --from=builder /opt/venv /opt/venv

# Crear directorio de trabajo
WORKDIR /workspace

# Configurar PATH para usar el venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/workspace/app \
    GRPC_VERBOSITY=ERROR \
    GLOG_minloglevel=2

# Copiar código de la aplicación (se montará como volumen pero tener fallback)
COPY app/ ./app/
COPY scripts/ ./scripts/

# Healthcheck para verificar que Python funciona
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import sys; sys.path.insert(0, '/workspace/app'); import squit_client; print('OK')" || exit 1

# Comando por defecto: CLI interactivo
CMD ["python3", "scripts/squit.py"]

