# ============================================================================
# SQUIT - Configuración de Variables de Ambiente
# ============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Completa los valores reales
# 3. NUNCA commitees el archivo .env al repositorio
# ============================================================================

# ============================================================================
# 🔐 GOOGLE CLOUD PLATFORM
# ============================================================================

# Project ID de GCP
GOOGLE_CLOUD_PROJECT=dfor-prj-dev

# Ruta al archivo de credenciales de service account
# Descarga desde: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Region por defecto
GCP_REGION=us-central1

# ============================================================================
# 📊 BIGQUERY
# ============================================================================

# Dataset principal
BIGQUERY_DATASET=deacero_sql_objects

# Tablas principales
BIGQUERY_SOURCE_TABLE=sql_objects_code
BIGQUERY_CHUNKS_TABLE=intelligent_chunks
BIGQUERY_EMBEDDINGS_TABLE=chunk_embeddings

# ============================================================================
# 🤖 GEMINI API
# ============================================================================

# API Key de Gemini para embeddings
# Obtén tu key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================================================
# 🔍 WEAVIATE (Vector Database)
# ============================================================================

# URL de Weaviate
WEAVIATE_URL=http://localhost:8080

# API Key de Weaviate (si aplica)
WEAVIATE_API_KEY=

# ============================================================================
# 🧠 AGENTIC RAG
# ============================================================================

# Modelo de chat (SIEMPRE usar gemini-2.5-flash)
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Configuración de generación
TEMPERATURE=0.1
MAX_TOKENS=8000
TOP_P=0.95

# ============================================================================
# 🔧 CONFIGURACIÓN DEL SISTEMA
# ============================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Ruta de logs
LOG_PATH=./logs

# Modo de ejecución (development, production)
ENVIRONMENT=development

# ============================================================================
# 📈 PERFORMANCE Y LÍMITES
# ============================================================================

# Tamaño de batch para procesamiento
BATCH_SIZE=1000

# Límite de jobs paralelos
MAX_PARALLEL_JOBS=10

# Rate limiting (requests por minuto)
RATE_LIMIT_RPM=60

# ============================================================================
# 🐳 DOCKER (si aplica)
# ============================================================================

# Usuario y grupo para Docker
UID=1000
GID=1000

# Puerto de la aplicación
APP_PORT=8000

# ============================================================================
# FIN
# ============================================================================