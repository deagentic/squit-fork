# ============================================================
# SQUIT MCP Server - Dockerfile
# Multi-stage build for Model Context Protocol server
# Supports STDIO (Claude Desktop) and HTTP (production)
# ============================================================

# Stage 1: Builder
FROM python:3.12-slim-bookworm AS builder

# Variables de entorno para optimizacion de Python
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

WORKDIR /build

# Instalar dependencias del sistema necesarias para compilacion
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Crear entorno virtual aislado
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copiar requirements e instalar dependencias
COPY requirements.txt requirements-mcp.txt ./

RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt --timeout=300 && \
    pip install --no-cache-dir -r requirements-mcp.txt --timeout=300

# ============================================================
# Stage 2: Runtime
# ============================================================
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /workspace

# Instalar solo dependencias de runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar venv del builder
COPY --from=builder /opt/venv /opt/venv

# Configurar entorno
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/workspace \
    PYTHONUNBUFFERED=1 \
    GRPC_VERBOSITY=ERROR \
    PORT=8000 \
    MCP_TRANSPORT=stdio \
    MCP_LOG_LEVEL=INFO

# Crear usuario no-root por seguridad
RUN useradd -m -u 1000 mcpuser

# Copiar codigo de la aplicacion
COPY --chown=mcpuser:mcpuser app/ ./app/

# Cambiar a usuario no-root
USER mcpuser

# Health check para modo HTTP
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD if [ "$MCP_TRANSPORT" = "http" ]; then curl -sf http://localhost:${PORT}/health || exit 1; else python -c "print('OK')"; fi

EXPOSE ${PORT}

# Entry point: MCP server
CMD ["python", "-m", "app.mcp_server"]
