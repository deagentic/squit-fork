[flake8]
max-line-length = 88
extend-ignore = E203,W503,E501
exclude = 
    .git,
    __pycache__,
    docs/,
    build/,
    dist/,
    .eggs/,
    *.egg-info/,
    .venv/,
    venv/,
    .env/
per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811,E402,F841
    examples/*:E402,F401,W291,C901
    *_health.py:F401,C901
max-complexity = 10
docstring-convention = google
